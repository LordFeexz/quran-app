---
import "@/styles/global.css";
import type { Metadata } from "@/interfaces/global";
import Header from "./header.astro";
import Footer from "./footer.astro";
import { cn } from "@/lib/utils";
import type { WithContext, Thing } from "schema-dts";
import { Toaster } from "@/components/ui/sonner";
import InstallPwaPrompt from "../common/install-pwa-prompt";

export interface Props {
  title: string;
  description?: string;
  className?: string;
  metadatas?: Metadata[];
  schema?: WithContext<Thing> | null;
}

const {
  title,
  description = "Website Al-Quran dan Hadith",
  className,
  metadatas = [],
  schema = null,
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <link rel="apple-touch-icon" href="/icons/icon-192x192.png" />
    <meta name="apple-mobile-web-app-title" content="Quran, Hadith, Sirah" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="msapplication-TileColor" content="#0f172a" />
    <meta name="msapplication-TileImage" content="/icons/icon-192x192.png" />

    <meta
      name="google-site-verification"
      content="yV4_49oVttwyR3x7vslJNmsMg6Ho4aFlcTqsvD6O8NA"
    />
    {metadatas.map(({ tag: Tag, ...rest }) => <Tag {...rest} />)}
    {
      schema && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(schema, null, 2)}
        />
      )
    }

    <!-- Prevent flashing light theme when set to dark mode -->
    <script is:inline>
      (() => {
        const getInitialTheme = () => {
          const savedTheme = localStorage.getItem("theme");
          const systemTheme = window.matchMedia("(prefers-color-scheme: dark)")
            .matches
            ? "dark"
            : "light";
          return savedTheme || systemTheme;
        };

        const theme = getInitialTheme();
        document.documentElement.classList.toggle("dark", theme === "dark");
      })();
    </script>
  </head>
  <body
    class="min-h-screen bg-background text-foreground transition-colors duration-300"
  >
    <div id="app" class="min-h-screen flex flex-col">
      <Header />
      <main id="main-content" class={cn("flex-1", className)}>
        <slot />
      </main>
      <Footer />
    </div>
    <Toaster client:only />
    <InstallPwaPrompt client:only />
  </body>
</html>
